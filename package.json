{
  "name": "restau-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "prepare": "husky",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture",
    "architecture:cruise": "depcruise --config .dependency-cruiser.cjs src",
    "architecture:check": "npm run test:architecture && npm run architecture:cruise",
    "test:phase13": "vitest run tests/phase13-enforcement.test.ts",
    "ci:quality": "npm run typecheck && npm run lint && npm run architecture:check && npm run test:phase13",
    "test:phase1:db": "node --env-file=.env.local scripts/test-data/run-phase1-db-tests.mjs --confirmed-development-test",
    "test:phase3:db": "node --env-file=.env.local scripts/test-data/run-phase3-db-tests.mjs --confirmed-development-test",
    "test:phase4:db": "node --env-file=.env.local scripts/test-data/run-phase4-db-tests.mjs --confirmed-development-test",
    "test:phase5:db": "node --env-file=.env.local scripts/test-data/run-phase5-db-tests.mjs --confirmed-development-test",
    "test:phase6:db": "node --env-file=.env.local scripts/test-data/run-phase6-db-tests.mjs --confirmed-development-test",
    "test:phase7:db": "node --env-file=.env.local scripts/test-data/run-phase7-db-tests.mjs --confirmed-development-test",
    "test:phase8:db": "node --env-file=.env.local scripts/test-data/run-phase8-db-tests.mjs --confirmed-development-test",
    "test:phase9:db": "node --env-file=.env.local scripts/test-data/run-phase9-db-tests.mjs --confirmed-development-test",
    "test:phase10:db": "node --env-file=.env.local scripts/test-data/run-phase10-db-tests.mjs --confirmed-development-test",
    "causality:reconcile": "node --env-file=.env.local --experimental-strip-types scripts/causality/reconcile.ts",
    "causality:requeue": "node --env-file=.env.local --experimental-strip-types scripts/causality/requeue-dead-letter.ts",
    "partners:reconcile": "node --env-file=.env.local --experimental-strip-types scripts/partners/reconcile.ts",
    "audit:phase1:anomalies": "node --env-file=.env.local scripts/test-data/capture-phase1-anomalies.mjs --confirmed-development-test",
    "test:e2e": "playwright test",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "api:openapi:export": "node --experimental-strip-types scripts/export-openapi-v1.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types drizzle/migrate.ts",
    "db:seed": "node --env-file=.env.local --import tsx scripts/test-data/seed.ts",
    "media:migrate-cloudinary": "node --env-file=.env.local --import tsx scripts/migrate-cloudinary-media.ts",
    "media:reconcile": "node --env-file=.env.local --experimental-strip-types scripts/media/reconcile.ts",
    "finance:diagnose": "node --env-file=.env.local --experimental-strip-types scripts/transactions/diagnose.ts",
    "orders:reconcile": "node --env-file=.env.local --experimental-strip-types scripts/orders/reconcile.ts",
    "pilot:check:test": "TOUTCI_DATA_ENVIRONMENT=test node --conditions=react-server --env-file=.env.local --import tsx scripts/pilot/controlled-test.ts --confirmed-development-test",
    "pilot:open:test": "TOUTCI_DATA_ENVIRONMENT=test node --conditions=react-server --env-file=.env.local --import tsx scripts/pilot/controlled-test.ts --confirmed-development-test --open",
    "test:phase6": "vitest run src/modules/transactions/model.test.ts src/modules/subscriptions/contracts.test.ts src/modules/quotas/model.test.ts tests/phase6-financial-unification.test.ts",
    "test:phase7": "vitest run src/modules/restaurants/model.test.ts src/modules/menu/model.test.ts src/modules/quotas/restaurant-model.test.ts tests/default-menu-categories.test.ts tests/phase7-restaurants-menu.test.ts",
    "test:phase8": "vitest run src/modules/residences/model.test.ts tests/phase8-residences.test.ts",
    "test:phase9": "vitest run src/modules/clients/model.test.ts src/modules/orders/model.test.ts src/modules/deliveries/model.test.ts tests/phase9-order-chain.test.ts",
    "test:phase10": "vitest run src/modules/audit/contracts.test.ts tests/phase10-cross-cutting.test.ts",
    "test:phase11": "vitest run tests/phase11-product-integrity.test.ts",
    "test:phase12": "vitest run tests/phase12-shared-kernel.test.ts",
    "test:phase5": "vitest run tests/phase5-identity-media.test.ts src/modules/media/model.test.ts src/modules/identity/model.test.ts src/modules/restaurants/model.test.ts",
    "db:studio": "drizzle-kit studio",
    "security:check-admin": "node --env-file=.env.local --experimental-strip-types scripts/security/check-seeded-admin.ts",
    "security:admin:reset": "node --env-file=.env.local --experimental-strip-types scripts/security/reset-admin-password.ts",
    "security:admin-totp:configure": "node scripts/security/configure-admin-totp-secret.mjs",
    "security:csp-check": "node scripts/security/csp-browser-check.mjs",
    "security:db-grant-runtime": "node --env-file=.env.local --experimental-strip-types scripts/security/grant-runtime-db-role.ts",
    "security:db-inspect": "node --env-file=.env.local --experimental-strip-types scripts/security/inspect-runtime-db.ts",
    "security:db-provision-runtime": "node --env-file=.env.local --experimental-strip-types scripts/security/provision-runtime-db-role.ts",
    "security:container-secrets": "node scripts/security/verify-container-secrets.mjs",
    "security:clamav-probe": "node scripts/security/clamav-probe.mjs",
    "security:vps-check": "node scripts/security/check-vps-env.mjs",
    "security:vps-env": "node scripts/security/generate-vps-env.mjs",
    "security:vercel-sync": "node scripts/security/sync-vercel-security-env.mjs",
    "security:kyc-worker": "node --env-file=.env.local scripts/security/kyc-scan-worker.mjs",
    "security:kyc-worker:once": "node --env-file=.env.local scripts/security/kyc-scan-worker.mjs --once",
    "security:kyc-sandbox:snapshot": "node --env-file=.env.local scripts/security/create-clamav-sandbox-snapshot.mjs",
    "geo:backfill-restaurants": "node --experimental-strip-types scripts/geo/backfill-restaurant-markets.ts",
    "geo:fetch-relations": "node --experimental-strip-types scripts/geo/fetch-osm-relations.ts",
    "geo:validate": "node --experimental-strip-types scripts/geo/validate-boundaries.ts",
    "geo:import": "node --experimental-strip-types scripts/geo/import-boundaries.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@base-ui/react": "^1.8.0",
