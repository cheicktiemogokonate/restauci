    "expo-server-sdk": "^6.1.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.3",
    "lenis": "^1.3.23",
    "lucide-react": "^1.21.0",
    "maplibre-gl": "^6.9.0",
    "motion": "^12.40.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.76.1",
    "recharts": "^3.8.1",
    "rough-notation": "^0.5.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
