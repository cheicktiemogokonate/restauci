# Base de données
DATABASE_URL="postgresql://user:password@host/toutci?sslmode=verify-full"
# URL propriétaire réservée à Drizzle et aux scripts d'administration. Ne
# jamais l'injecter dans le runtime de l'application.
DATABASE_MIGRATION_URL="postgresql://migration-owner:password@host/toutci?sslmode=verify-full"
DATABASE_RUNTIME_ROLE="toutci_app"
# Origine de l'environnement de données. Obligatoire pour toute création de
# fixtures durables ; utiliser "production" sur les déploiements réels.
TOUTCI_DATA_ENVIRONMENT="development"

# Authentification
JWT_SECRET="minimum-32-characters-secret-key-here"
JWT_COOKIE_NAME="restauci_session"
# Protection active par défaut. Mettre explicitement false constitue une
# exception temporaire de sécurité et chaque connexion admin sera journalisée.
ADMIN_MFA_REQUIRED="true"
# Secret Base32 TOTP administrateur, fourni par le gestionnaire de secrets.
# Configuration locale sûre (convertit aussi l'ancien format hexadécimal) :
# npm run security:admin-totp:configure
# Synchronisation Vercel Production, valeur toujours masquée :
# npm run security:admin-totp:configure -- --sync-vercel-production
# ADMIN_TOTP_SECRET="BASE32_SECRET_FROM_SECRET_MANAGER"

# Seed de développement (min 12 caractères, jamais de valeur en dur dans le code)
# Lancer uniquement avec : npm run db:seed -- --confirmed-development-test
# SEED_PASSWORD="generate-with-openssl-rand-base64-24"
# Contrôle incident : injecter uniquement depuis le gestionnaire de secrets.
# SECURITY_CHECK_EMAILS="security-test-admin@example.test,security-test-partner@example.test"
# COMPROMISED_PASSWORD="do-not-store-this-value-in-a-file"

# Comptes réservés à une base E2E isolée (jamais des comptes réels).
# E2E_ADMIN_EMAIL="e2e-admin@example.test"
# E2E_ADMIN_PASSWORD="generated-test-secret"
# E2E_PARTNER_EMAIL="e2e-partner@example.test"
# E2E_PARTNER_PASSWORD="generated-test-secret"

# Cache Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"
# Sur VPS, ces deux variables peuvent pointer vers le proxy REST interne
# serverless-redis-http devant Valkey. Aucun port Redis ne doit être publié.

# Cache de données métier : désactivé par défaut. Redis reste utilisé pour le
# rate limiting et le temps réel. Activez uniquement après avoir mesuré le besoin.
DATA_CACHE_ENABLED="false"

# Politique géographique Restaurants : shadow pendant l'import/backfill,
# enforce uniquement après publication et validation des marchés.
RESTAURANT_GEO_POLICY_MODE="shadow"
RESIDENCE_GEO_POLICY_MODE="off"
EVENT_GEO_POLICY_MODE="off"

# Tâches planifiées (32 caractères minimum, obligatoire en production)
CRON_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Upload médias (Cloudflare R2)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="toutci-media"
R2_PUBLIC_URL="https://media.example.com"

# Documents d'identité : bucket R2 distinct, privé, sans domaine public.
R2_KYC_BUCKET_NAME="your-private-kyc-bucket-name"
R2_KYC_ACCESS_KEY_ID="your-private-kyc-access-key-id"
R2_KYC_SECRET_ACCESS_KEY="your-private-kyc-secret-access-key"

# Interface KYC S3-compatible portable. Ces variables remplacent R2_KYC_* dès
# qu'elles sont définies et fonctionnent avec R2, SeaweedFS, Ceph RGW ou S3.
# KYC_STORAGE_ENDPOINT="https://s3.example.com"
# KYC_STORAGE_REGION="auto"
# KYC_STORAGE_ACCESS_KEY_ID="kyc-access-key"
# KYC_STORAGE_SECRET_ACCESS_KEY="kyc-secret-key"
# KYC_STORAGE_BUCKET="toutci-kyc-private"
# KYC_STORAGE_FORCE_PATH_STYLE="false"

# Backend d'analyse KYC. Sur Vercel, créez d'abord le snapshot ClamAV avec :
# npm run security:kyc-sandbox:snapshot
# KYC_SCAN_BACKEND="vercel_sandbox"
# KYC_CLAMAV_SANDBOX_SNAPSHOT_ID="snap_example"
# Nombre maximal de scans métier et délai avant reprise d'un job interrompu.
# KYC_SCAN_MAX_ATTEMPTS="3"
# KYC_SCAN_STALE_AFTER_SECONDS="900"

# Worker KYC libre : ClamAV + Dangerzone CLI. Le socket TCP ClamAV ne doit
# jamais être publié sur Internet ; limitez-le au réseau privé/loopback.
# CLAMAV_HOST="127.0.0.1"
# CLAMAV_PORT="3310"
# DANGERZONE_CLI_PATH="dangerzone-cli"
# KYC_SCAN_POLL_MS="5000"

# Web Push : hôtes HTTPS supplémentaires, séparés par des virgules. Les
# fournisseurs FCM, Mozilla, Apple et Windows connus sont déjà autorisés.
# WEB_PUSH_ALLOWED_HOSTS="push.example-provider.com"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Toutci"
# À fixer pour les déploiements multi-instance/rolling. Valeur base64 de
# 32 octets : openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="base64-aes-256-key"
# Identifiant unique par version déployée, par exemple le SHA Git.
# DEPLOYMENT_VERSION="git-commit-sha"
# Deep link utilisé après un paiement lancé depuis l'application mobile.
MOBILE_APP_PAYMENT_RETURN_URL="toutci://payments/callback"
NODE_ENV="development"

# Paiements (secret serveur, commencer exclusivement en TEST)
PAYSTACK_SECRET_KEY="sk_test_your_paystack_test_secret_key"
