# Base de données
DATABASE_URL="postgresql://user:password@host/toutci?sslmode=verify-full"

# Authentification
JWT_SECRET="minimum-32-characters-secret-key-here"
JWT_COOKIE_NAME="restauci_session"

# Cache Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# Cache de données métier : désactivé par défaut. Redis reste utilisé pour le
# rate limiting et le temps réel. Activez uniquement après avoir mesuré le besoin.
DATA_CACHE_ENABLED="false"

# Upload médias (Cloudflare R2)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="toutci-media"
R2_PUBLIC_URL="https://media.example.com"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Toutci"
NODE_ENV="development"
