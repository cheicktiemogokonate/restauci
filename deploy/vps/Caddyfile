{
	email {$ACME_EMAIL}
	admin off
	servers {
		max_header_size 32KB
		0rtt off
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# La plus grosse charge autorisée par l'application est un document KYC
	# de 8 Mo. La marge couvre l'encapsulation multipart.
	request_body {
		max_size 10MB
	}

	log {
		output file /var/log/caddy/access.json {
			roll_size 100MB
			roll_keep 10
			roll_keep_for 336h
		}
		format json
	}

	reverse_proxy app:3000 {
		# Caddy ignore les X-Forwarded-* entrants non fiables et reconstruit
		# ceux transmis à Next.js, ce qui protège le rate limiting par IP.
		flush_interval -1
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
		lb_try_duration 5s
	}
}
