# Paramètres publics à remplacer avant le premier déploiement.
APP_DOMAIN=app.example.com
ACME_EMAIL=security@example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_APP_NAME=Toutci
NODE_ENV=production

# PostgreSQL : compte runtime seulement. Le compte propriétaire/migration ne
# doit jamais figurer dans ce fichier chargé par le conteneur web.
DATABASE_URL=postgresql://restau_runtime:replace@host/database?sslmode=verify-full
DATABASE_RUNTIME_ROLE=restau_runtime

# Générés automatiquement par scripts/security/generate-vps-env.mjs.
JWT_SECRET=__GENERATE__
JWT_COOKIE_NAME=restauci_session
CRON_SECRET=__GENERATE__
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=__GENERATE__
REDIS_HTTP_TOKEN=__GENERATE__
VALKEY_PASSWORD=__GENERATE__

# Protection active par défaut. `false` est une exception temporaire qui doit
# être suivie et retirée dès que le TOTP peut être enrôlé.
ADMIN_MFA_REQUIRED=true
# Lorsque la protection est active, l'absence du secret bloque les connexions
# administrateur en production.
# ADMIN_TOTP_SECRET=

# @upstash/redis est redirigé par Compose vers ce bridge interne Valkey.
UPSTASH_REDIS_REST_URL=http://redis-http:8080
UPSTASH_REDIS_REST_TOKEN=__GENERATE__
DATA_CACHE_ENABLED=false

RESTAURANT_GEO_POLICY_MODE=shadow
RESIDENCE_GEO_POLICY_MODE=off
EVENT_GEO_POLICY_MODE=off
MOBILE_APP_PAYMENT_RETURN_URL=toutci://payments/callback

# Médias publics R2 actuels (optionnels si la fonctionnalité est désactivée).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=toutci-media
# R2_PUBLIC_URL=https://media.example.com

# Compatibilité avec le bucket KYC R2 privé existant. Ces variables sont
# utilisées si l'interface KYC_STORAGE_* ci-dessous n'est pas configurée.
# R2_KYC_BUCKET_NAME=toutci-kyc-private
# R2_KYC_ACCESS_KEY_ID=
# R2_KYC_SECRET_ACCESS_KEY=

# Stockage privé KYC S3-compatible. R2 peut continuer à être utilisé depuis
# le VPS ; SeaweedFS/Ceph RGW peuvent le remplacer sans changement de code.
# KYC_STORAGE_ENDPOINT=https://s3.example.com
# KYC_STORAGE_REGION=auto
# KYC_STORAGE_ACCESS_KEY_ID=
# KYC_STORAGE_SECRET_ACCESS_KEY=
# KYC_STORAGE_BUCKET=toutci-kyc-private
# KYC_STORAGE_FORCE_PATH_STYLE=false

# Worker KYC exécuté sur l'hôte sous un utilisateur dédié.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
DANGERZONE_CLI_PATH=/usr/bin/dangerzone-cli
KYC_SCAN_MAX_ATTEMPTS=3
KYC_SCAN_POLL_MS=5000

# Secrets/fournisseurs optionnels à décommenter selon les fonctions activées.
# PAYSTACK_SECRET_KEY=sk_test_replace
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:security@example.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# EXPO_ACCESS_TOKEN=
# WEB_PUSH_ALLOWED_HOSTS=

# Pour les déploiements rolling multi-instance, définir un SHA différent à
# chaque release. Laisser absent pour le VPS mono-instance initial.
# DEPLOYMENT_VERSION=git-commit-sha
